# AEP Platform - environment variable reference.
# Copy this file to `.env` and fill in real local values (never commit `.env`).
# Every value below is a placeholder - no real secret ever belongs in this
# repo, in `.env.example`, or in `.env` if `.env` is ever committed by mistake.
# Load it however your shell/tooling prefers, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or use `python-dotenv`/`direnv` if you already have one of those set up.

# ---------------------------------------------------------------------------
# PostgreSQL (OPTIONAL for normal use - AEP provisions and manages its own
# local embedded PostgreSQL automatically when NONE of the AEP_PG_*/
# AEP_POSTGRES_DSN vars below are set; see docs/DATABASE.md and
# src/aep/db/local_postgres.py). Set these ONLY if you want AEP to use a
# Postgres you manage yourself (a shared dev server, Supabase, cloud
# Postgres, etc.) instead of its own local one.
# ---------------------------------------------------------------------------

# OPTIONAL. Only needed if you're pointing AEP at your own Postgres.
AEP_PG_PASSWORD=<POSTGRES_PASSWORD>

# OPTIONAL - all have sane local-dev defaults, override only if your local
# Postgres differs from the documented dev convention (docs/DATABASE.md).
AEP_PG_HOST=localhost
AEP_PG_PORT=5432
AEP_PG_USER=aep
AEP_PG_DBNAME=aep_platform
# Set to "require" for Supabase or any TLS-required Postgres. Unset locally.
AEP_PG_SSLMODE=

# OPTIONAL - a full DSN string, used verbatim if set (takes priority over
# every AEP_PG_* part above).
AEP_POSTGRES_DSN=

# OPTIONAL. Backend selection: "postgres" (default) or "sqlite" (explicit
# opt-in only, legacy/reference path - see docs/DATABASE.md).
AEP_DB_BACKEND=postgres

# ---------------------------------------------------------------------------
# API (src/aep/api/app.py, src/aep/api/auth.py)
# ---------------------------------------------------------------------------

# DEMO-ONLY / local dev only. Set to "1" to disable API-key auth entirely for
# local development. Prints a loud warning once at startup. Never set this in
# a real deployment.
AEP_API_DEV_MODE=0

# EXTERNAL-INTEGRATION - not an env var: real API keys are project-scoped
# rows in the `api_keys` table (see docs/API.md), not an environment
# variable. Nothing to set here for auth itself.

# ---------------------------------------------------------------------------
# AI provider gateway / OmniRoute (src/aep/ai_gateway/omniroute_provider.py)
# OPTIONAL overall - the demo runs fine on FakeAIProvider with none of this
# set. Fill in only if you have a real OmniRoute-compatible endpoint.
# ---------------------------------------------------------------------------

# EXTERNAL-INTEGRATION / OPTIONAL. Label only, defaults to "omniroute".
AI_PROVIDER=omniroute

# EXTERNAL-INTEGRATION / OPTIONAL. Required together with AI_CREDENTIAL to
# make OmniRoute available; if unset, `aep providers` honestly reports
# OmniRoute as UNAVAILABLE (this is the default state of this sandbox).
AI_BASE_URL=<OMNIROUTE_BASE_URL>

# EXTERNAL-INTEGRATION / OPTIONAL. Never logged, never a real value in this
# repo. Sent once per request as an outbound Authorization: Bearer header.
AI_CREDENTIAL=<OMNIROUTE_CREDENTIAL>

# ---------------------------------------------------------------------------
# Web UI (ui/src/api.ts) - set these in ui/.env.local, NOT this file, since
# Vite only reads env files from within ui/. Listed here for reference only.
# ---------------------------------------------------------------------------

# OPTIONAL. Defaults to http://localhost:5000 if unset.
VITE_API_BASE=http://localhost:5000

# OPTIONAL - only needed when AEP_API_DEV_MODE is not "1". A real project-
# scoped API key looks like "aep_...".
VITE_API_KEY=<AEP_API_KEY>

# ---------------------------------------------------------------------------
# GitHub (src/aep/secrets.py -> SecretManager, used by src/aep/github/client.py
# and src/aep/tools/github_tool.py)
# ---------------------------------------------------------------------------

# EXTERNAL-INTEGRATION / OPTIONAL. A token with repo + actions scopes.
# BLOCKED in this sandbox regardless (api.github.com is network-egress
# blocked) - only useful outside this sandbox.
AEP_SECRET_GITHUB_TOKEN=<GITHUB_TOKEN>

# ---------------------------------------------------------------------------
# Cloud / AWS (src/aep/infra/cloud/aws_adapter.py) - read-only adapter,
# credential resolution is entirely boto3's own standard chain (environment,
# ~/.aws/credentials, instance profile, etc.) - AEP itself defines no
# AWS-specific env var. Listed here only because boto3 will pick these up if
# present in your shell.
# ---------------------------------------------------------------------------

# EXTERNAL-INTEGRATION / OPTIONAL (boto3 standard, not AEP-defined).
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=<AWS_REGION>
